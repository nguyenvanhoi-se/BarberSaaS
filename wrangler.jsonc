{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barbersaas",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "10001", "simple": { "limit": 30, "period": 60 } },
    { "name": "BOOKING_RATE_LIMIT", "namespace_id": "10002", "simple": { "limit": 12, "period": 60 } },
    { "name": "DOMAIN_RATE_LIMIT", "namespace_id": "10003", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_RATE_LIMIT", "namespace_id": "10004", "simple": { "limit": 20, "period": 60 } },
    { "name": "EMAIL_RATE_LIMIT", "namespace_id": "10005", "simple": { "limit": 3, "period": 60 } }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barbersaas-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "barbersaas-staging",
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application"
      },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMIT", "namespace_id": "10001", "simple": { "limit": 30, "period": 60 } },
        { "name": "BOOKING_RATE_LIMIT", "namespace_id": "10002", "simple": { "limit": 12, "period": 60 } },
        { "name": "DOMAIN_RATE_LIMIT", "namespace_id": "10003", "simple": { "limit": 10, "period": 60 } },
        { "name": "UPLOAD_RATE_LIMIT", "namespace_id": "10004", "simple": { "limit": 20, "period": 60 } },
        { "name": "EMAIL_RATE_LIMIT", "namespace_id": "10005", "simple": { "limit": 3, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "barbersaas-staging-db",
          "database_id": "d32ec225-aa1b-4bf9-83a4-c3f2b87c4064",
          "migrations_dir": "migrations",
          "remote": true
        }
      ]
    }
  }
}
